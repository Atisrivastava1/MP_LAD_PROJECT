# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (production target)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mplads_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-before-demo
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ─── ML Mode ──────────────────────────────────────────────────────────────────
# Set to "mock" during development / when ml_engine is not yet available.
# Set to "real" when teammate delivers ml_engine package.
ML_MODE=mock

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIRECTORY=uploads
